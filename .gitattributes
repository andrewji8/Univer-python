# Normalize line endings: LF in the repo, native checkout
* text=auto eol=lf

# Explicit text types
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary / never-touch
*.png binary
*.jpg binary
*.ico binary
poetry.lock linguist-generated=true -diff
